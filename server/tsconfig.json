{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../dist/server",
    "rootDir": "..",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": false
  },
  "include": ["**/*.ts", "../types.ts"],
  "exclude": ["node_modules", "../node_modules"]
}
